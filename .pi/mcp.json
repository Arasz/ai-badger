{
  "mcpServers": {
    "code-review-graph": {
      "command": "code-review-graph",
      "args": [
        "serve"
      ],
      "exposure": "direct"
    },
    "hermes": {
      "command": "hermes",
      "args": [
        "mcp",
        "serve"
      ],
      "exposure": "direct"
    },
    "ai-raccoon": {
      "command": "ai-raccoon",
      "exposure": "direct"
    },
    "semantica": {
      "command": "semantica-mcp",
      "env": {
        "SEMANTICA_DISABLE_PROGRESS": "1"
      },
      "exposure": "direct"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "exposure": "direct"
    },
    "task-graph": {
      "command": "uv",
      "args": [
        "run",
        "--script",
        ".ai-badger/skills/task-decomposition/scripts/task_graph_server.py"
      ],
      "exposure": "direct"
    }
  }
}
