# ai-badger framework repo
__pycache__/
*.pyc
.DS_Store
# per-project tracking state (only relevant in scaffolded repos, guarded here defensively)
task-tracking/
.ai-badger/task-tracking/
# learned-skill sync (learned_skills_sync.py): one-way hook output carrying machine-specific
# absolute paths (the shipped-paths guard refuses them); never part of a commit
.ai-badger/skills/learned/
.ai-badger/skills-data/hermes/learned.json
# Added by code-review-graph
.code-review-graph/
# den-refresh backup of a previous scaffold
.ai-badger.bckp/
# JetBrains Rider user-specific inspection and solution settings
*.DotSettings.user
# prompt-marker history: stores whole prompts verbatim
.ai-badger/prompt-markers/
# subagent worktrees: a full nested checkout, never part of a commit
.claude/worktrees/
# task worktrees, in the agent-neutral place the /task skill puts them
.ai-badger/worktrees/
# per-developer lefthook overrides: personal skips are never shared
lefthook-local.yml
# hook run logs (generated by .lefthook/pre-push/verify.sh)
logs/
# working documents retired from docs/: plans, reviews, designs, specs, research, incidents.
# Kept on disk for reference; git history holds them for anyone who needs the record.
.tmp/
# mutmut's working copy of the mutated tree (.lefthook/pre-push/verify.sh mutation lane)
mutants/
# machine-specific: cwd is an absolute path to THIS checkout, and ${CLAUDE_PROJECT_DIR} does
# not expand there (docs/changelog/0.32.0-defects-found-by-a-real-refresh.md). Tracking it
# shipped two permanently-broken user-global MCP servers to every plugin installer (issue
# #173, ADR-0014 decision 6). Copy .mcp.json.example and fill in your own cwd.
.mcp.json
# config_guard's safety copy before a merge or a retirement (config_guard.py); one of these
# was committed by accident and shipped the same absolute path .mcp.json did (issue #173).
.claude/*.bak-*
.github/**/*.bak-*
# mcp writer's safety copy of the ignored .mcp.json before a rewrite (mcp_tools.py)
.mcp.json.bak-*
# local Semantica session-graph staging dir; the durable record lives in ai-raccoon memory
.semantica/
# red_proof.py's journal (design-tests skill); a killed run leaves this behind, and it is
# never part of a commit
.design-tests/
# bun/tsc harness for the pi TypeScript extensions: dependencies only, never committed
features/pi/node_modules/

# BEGIN ai-badger managed block — do not edit; regenerated by welcome-ai-badger
.ai-badger/task-tracking/tracking.db
.ai-badger/task-tracking/*.db-wal
.ai-badger/task-tracking/*.db-shm
# END ai-badger managed block
