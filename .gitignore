# ai-badger framework repo
__pycache__/
*.pyc
.DS_Store
# per-project tracking state (only relevant in scaffolded repos, guarded here defensively)
task-tracking/
.ai-badger/task-tracking/
# Added by code-review-graph
.code-review-graph/
# den-refresh backup of a previous scaffold
.ai-badger.bckp/
# prompt-marker history: stores whole prompts verbatim
.ai-badger/prompt-markers/
# subagent worktrees: a full nested checkout, never part of a commit
.claude/worktrees/
# per-developer lefthook overrides: personal skips are never shared
lefthook-local.yml
# hook run logs (generated by .lefthook/pre-push/verify.sh)
logs/
# working documents retired from docs/: plans, reviews, designs, specs, research, incidents.
# Kept on disk for reference; git history holds them for anyone who needs the record.
.tmp/
# mutmut's working copy of the mutated tree (.lefthook/pre-push/verify.sh mutation lane)
mutants/
# machine-specific: cwd is an absolute path to THIS checkout, and ${CLAUDE_PROJECT_DIR} does
# not expand there (docs/changelog/0.32.0-defects-found-by-a-real-refresh.md). Tracking it
# shipped two permanently-broken user-global MCP servers to every plugin installer (issue
# #173, ADR-0014 decision 6). Copy .mcp.json.example and fill in your own cwd.
.mcp.json
# config_guard.write_with_backup's safety copy before a merge (config_guard.py); one of these
# was committed by accident and shipped the same absolute path .mcp.json did (issue #173).
.claude/*.bak-*
