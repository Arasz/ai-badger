{
  "agent": "claude",
  "instructions": {
    "marketplace": {
      "description": "Add a Claude Code marketplace, then install a plugin from it by name",
      "commands": [
        "claude plugin marketplace add {source}",
        "claude plugin install {name}@{sourceName}"
      ]
    },
    "url": {
      "description": "Install from URL",
      "commands": ["claude plugin install {source}"]
    }
  }
}
