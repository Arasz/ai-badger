{
  "description": "Command shapes for hooks that get rewritten into an agent's own config (.claude/settings.json, .github/hooks/). Paths under ${CLAUDE_PLUGIN_ROOT}/features/common/skills/ are rewritten to the project's .ai-badger/skills/ copy. Each manifest entry selects its command here by its `script` name — Claude deliberately skips drift_notice_hook.py, which is plugin-provided via hooks/hooks.json at the repo root and needs a ${CLAUDE_PLUGIN_ROOT} only the plugin loader substitutes.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/features/common/skills/mcp-index/scripts/context_enrichment_hook.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/features/common/skills/task/scripts/session_start_hook.py\""
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/features/common/skills/task/scripts/drift_notice_hook.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/features/common/skills/task/scripts/stop_hook.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/features/common/skills/task/scripts/stop_hook.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/features/common/skills/task/scripts/dispatch_gate_hook.py\""
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/features/common/skills/ai-raccoon-memory/scripts/memory_first_gate_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/features/common/skills/commit-reminder/scripts/commit_reminder_hook.py\""
          }
        ]
      },
      {
        "matcher": "memory_search",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/features/common/skills/ai-raccoon-memory/scripts/memory_grade_hook.py\""
          }
        ]
      }
    ]
  }
}
