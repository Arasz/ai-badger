{
  "hooks": [
    {
      "name": "drift-notice",
      "description": "Detect framework version drift on session start",
      "agents": {
        "claude": { "type": "hooks-json", "entry": "hooks.json", "event": "SessionStart" },
        "hermes": { "type": "plugin", "entry": "ai_badger_hooks.py", "method": "on_session_start" },
        "copilot": { "type": "hooks-json", "entry": "hooks.json", "event": "sessionStart" }
      }
    },
    {
      "name": "context-enrichment",
      "description": "Inject framework context into every LLM turn",
      "agents": {
        "hermes": { "type": "plugin", "entry": "ai_badger_hooks.py", "method": "pre_llm_call" }
      }
    },
    {
      "name": "prompt-markers",
      "description": "Detect prompt markers (h:, f:, e:) and inject behavior context",
      "agents": {
        "claude": { "type": "hooks-json", "entry": "hooks.json", "event": "UserPromptSubmit" },
        "copilot": { "type": "hooks-json", "entry": "hooks.json", "event": "userPromptSubmitted" }
      }
    }
  ]
}
