{
  "hooks": [
    {
      "name": "drift-notice",
      "description": "Detect framework version drift on session start",
      "agents": {
        "claude": { "type": "plugin-hooks-json", "entry": "hooks.json", "event": "SessionStart", "script": "drift_notice_hook.py" },
        "hermes": { "type": "plugin", "entry": "ai_badger_hooks.py", "method": "on_session_start" },
        "copilot": { "type": "hooks-json", "entry": "hooks.json", "event": "sessionStart", "script": "drift_notice_hook.py" }
      }
    },
    {
      "name": "session-start-tracking",
      "description": "Record the session id and transcript, surface unfinished tracked tasks, and start the usage-limit poller",
      "agents": {
        "claude": { "type": "hooks-json", "entry": "hooks.json", "event": "SessionStart", "script": "session_start_hook.py" }
      }
    },
    {
      "name": "context-enrichment",
      "description": "Inject framework context, including MCP tool recommendations, into every LLM turn",
      "agents": {
        "claude": { "type": "hooks-json", "entry": "hooks.json", "event": "UserPromptSubmit", "script": "context_enrichment_hook.py" },
        "hermes": { "type": "plugin", "entry": "ai_badger_hooks.py", "method": "pre_llm_call" },
        "copilot": { "type": "hooks-json", "entry": "hooks.json", "event": "userPromptSubmitted", "script": "context_enrichment_hook.py" }
      }
    },
    {
      "name": "prompt-markers",
      "description": "Detect prompt markers (h:, f:, e:) and inject behavior context",
      "agents": {
        "claude": { "type": "hooks-json", "entry": "hooks.json", "event": "UserPromptSubmit", "script": "user_prompt_hook.py" },
        "copilot": { "type": "hooks-json", "entry": "hooks.json", "event": "userPromptSubmitted", "script": "user_prompt_hook.py" }
      }
    },
    {
      "name": "commit-reminder",
      "description": "Nudge toward smaller, more frequent commits once uncommitted file count crosses a threshold",
      "agents": {
        "claude": { "type": "hooks-json", "entry": "hooks.json", "event": "PostToolUse", "script": "commit_reminder_hook.py" },
        "hermes": { "type": "plugin", "entry": "ai_badger_hooks.py", "method": "post_tool_call" },
        "copilot": { "type": "hooks-json", "entry": "hooks.json", "event": "postToolUse", "script": "commit_reminder_hook.py" }
      }
    }
  ]
}
