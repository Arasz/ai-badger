{
  "$schema": "../../schemas/stack-mcp.schema.json",
  "servers": [
    {
      "name": "code-review-graph",
      "command": "code-review-graph serve",
      "declare": true
    },
    {
      "name": "hermes",
      "command": "hermes mcp serve",
      "declare": true,
      "availability": {
        "command": "hermes"
      }
    },
    {
      "name": "ai-raccoon",
      "command": "ai-raccoon",
      "declare": true,
      "availability": {
        "command": "ai-raccoon"
      }
    },
    {
      "name": "semantica",
      "command": "semantica-mcp",
      "declare": true,
      "env": {
        "SEMANTICA_DISABLE_PROGRESS": "1"
      },
      "availability": {
        "command": "semantica-mcp"
      }
    },
    {
      "name": "playwright",
      "command": "npx -y @playwright/mcp@latest",
      "declare": true,
      "availability": {
        "command": "npx"
      }
    },
    {
      "name": "task-graph",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "python",
        "-c",
        "import os,sys,subprocess;from pathlib import Path;r='.ai-badger/skills/task-decomposition/scripts/task_graph_server.py';c=Path.cwd();f=next((d/r for d in (c,*c.parents) if (d/r).is_file()),None);f or sys.exit('task-graph: '+r+' not found at or above '+str(c));sys.exit(subprocess.call([os.environ.get('UV','uv'),'run','--script',str(f)]))"
      ],
      "declare": true
    }
  ]
}
