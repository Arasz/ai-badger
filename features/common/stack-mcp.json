{
  "$schema": "../../schemas/stack-mcp.schema.json",
  "servers": [
    {
      "name": "code-review-graph",
      "command": "code-review-graph serve",
      "declare": true
    },
    {
      "name": "hermes",
      "command": "hermes mcp serve",
      "declare": true,
      "availability": {
        "command": "hermes"
      }
    },
    {
      "name": "ai-raccoon",
      "command": "ai-raccoon",
      "declare": true,
      "availability": {
        "command": "ai-raccoon"
      }
    },
    {
      "name": "semantica",
      "command": "semantica-mcp",
      "declare": true,
      "env": {
        "SEMANTICA_DISABLE_PROGRESS": "1"
      },
      "availability": {
        "command": "semantica-mcp"
      }
    },
    {
      "name": "playwright",
      "command": "npx -y @playwright/mcp@latest",
      "declare": true,
      "availability": {
        "command": "npx"
      }
    },
    {
      "name": "task-graph",
      "command": "uv run --script .ai-badger/skills/task-decomposition/scripts/task_graph_server.py",
      "declare": true,
      "agentOverrides": {
        "claude": {
          "command": "sh",
          "args": [
            "-c",
            "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && exec uv run --script .ai-badger/skills/task-decomposition/scripts/task_graph_server.py"
          ]
        },
        "copilot": {
          "command": "sh",
          "args": [
            "-c",
            "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && exec uv run --script .ai-badger/skills/task-decomposition/scripts/task_graph_server.py"
          ]
        },
        "pi": {
          "command": "sh",
          "args": [
            "-c",
            "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && exec uv run --script .ai-badger/skills/task-decomposition/scripts/task_graph_server.py"
          ]
        }
      }
    }
  ]
}
