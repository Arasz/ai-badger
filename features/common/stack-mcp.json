{
  "$schema": "../../schemas/stack-mcp.schema.json",
  "servers": [
    {
      "name": "code-review-graph",
      "command": "code-review-graph serve",
      "declare": true
    },
    {
      "name": "hermes",
      "command": "hermes mcp serve",
      "declare": true,
      "availability": {
        "command": "hermes"
      }
    },
    {
      "name": "ai-raccoon",
      "command": "ai-raccoon",
      "declare": true,
      "availability": {
        "command": "ai-raccoon"
      }
    },
    {
      "name": "semantica",
      "command": "semantica-mcp",
      "declare": true,
      "availability": {
        "command": "semantica-mcp"
      }
    },
    {
      "name": "playwright",
      "command": "npx -y @playwright/mcp@latest",
      "declare": true,
      "availability": {
        "command": "npx"
      }
    }
  ]
}
