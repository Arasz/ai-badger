{
  "$schema": "../../schemas/support.schema.json",
  "description": "Agent capability matrix: what each agent supports and what ai-badger scaffolds for it.",
  "lastUpdated": "2026-08-28",
  "agents": {
    "claude": {
      "name": "Claude Code",
      "vendor": "Anthropic",
      "capabilities": {
        "instructions": {
          "supported": true,
          "mechanism": "CLAUDE.md (always loaded), .claude/settings.json",
          "aiBadgerSupport": true,
          "scaffoldedFile": "CLAUDE.md"
        },
        "invariants": {
          "supported": true,
          "mechanism": "CLAUDE.md sections",
          "aiBadgerSupport": true
        },
        "scopedInstructions": {
          "supported": false,
          "mechanism": null,
          "aiBadgerSupport": false
        },
        "personas": {
          "supported": true,
          "mechanism": "native agent modes",
          "aiBadgerSupport": true
        },
        "hooks": {
          "supported": true,
          "mechanism": "Plugin hooks: SessionStart, UserPromptSubmit, PreToolUse, PostToolUse, Notification",
          "configPath": ".claude/settings.json",
          "aiBadgerSupport": true,
          "wiredBy": "scaffold.py wire_hooks()"
        },
        "skills": {
          "supported": true,
          "mechanism": "SKILL.md with YAML frontmatter, discovered from .claude/skills/ or plugin dirs",
          "aiBadgerSupport": true,
          "scaffoldedBy": "scaffold.py symlink_hermes_skills() for hermes; direct copy for claude"
        },
        "customAgents": {
          "supported": false,
          "mechanism": null,
          "aiBadgerSupport": false
        },
        "plugins": {
          "supported": true,
          "mechanism": "claude plugin marketplace/install",
          "aiBadgerSupport": true,
          "wiredBy": "scaffold.py install_plugins()"
        },
        "mcpServers": {
          "supported": true,
          "mechanism": ".mcp.json (project-scoped) + ~/.claude/settings.json (user-scoped)",
          "aiBadgerSupport": true,
          "scaffoldedBy": "scaffold.py _generate_mcp_json() + _scaffold_claude_mcp_user()"
        },
        "cacheAwareDispatch": {
          "supported": true,
          "mechanism": "Native context caching",
          "aiBadgerSupport": true
        },
        "feedbackLoop": {
          "supported": true,
          "mechanism": "feed-badger detects additions → PR",
          "aiBadgerSupport": true
        }
      }
    },
    "hermes": {
      "name": "Hermes Agent",
      "vendor": "Nous Research",
      "capabilities": {
        "instructions": {
          "supported": true,
          "mechanism": "HERMES.md, .hermes.md (always loaded)",
          "aiBadgerSupport": true,
          "scaffoldedFile": "HERMES.md"
        },
        "invariants": {
          "supported": true,
          "mechanism": "HERMES.md sections, always-loaded memory",
          "aiBadgerSupport": true
        },
        "scopedInstructions": {
          "supported": false,
          "mechanism": null,
          "aiBadgerSupport": false
        },
        "personas": {
          "supported": true,
          "mechanism": "Native subagent roles (leaf/orchestrator)",
          "aiBadgerSupport": true
        },
        "hooks": {
          "supported": true,
          "mechanism": "Plugin hooks: on_session_start, pre_llm_call, post_tool_call",
          "configPath": "~/.hermes/config.yaml plugins",
          "aiBadgerSupport": true,
          "wiredBy": "ai_badger_hooks.py plugin"
        },
        "skills": {
          "supported": true,
          "mechanism": "SKILL.md with YAML frontmatter, discovered from ~/.hermes/skills/ and external_dirs",
          "aiBadgerSupport": true,
          "scaffoldedBy": "scaffold.py symlink_hermes_skills() — namespaced under ~/.hermes/skills/<project>/"
        },
        "customAgents": {
          "supported": false,
          "mechanism": null,
          "aiBadgerSupport": false
        },
        "plugins": {
          "supported": false,
          "mechanism": null,
          "aiBadgerSupport": false
        },
        "mcpServers": {
          "supported": true,
          "mechanism": "~/.hermes/config.yaml mcp_servers (user-global; no project route), with per-server tools include/exclude globs applied at registration",
          "aiBadgerSupport": false,
          "scaffoldedBy": "nothing is scaffolded: hermes/adjustments/adjust_mcp.py prints the mcp_servers snippet for the operator to merge (ADR-0014 decision 6)"
        },
        "cacheAwareDispatch": {
          "supported": true,
          "mechanism": "Native context caching",
          "aiBadgerSupport": true
        },
        "feedbackLoop": {
          "supported": true,
          "mechanism": "feed-badger detects additions → PR",
          "aiBadgerSupport": true
        }
      }
    },
    "copilot": {
      "name": "GitHub Copilot CLI",
      "vendor": "GitHub/Microsoft",
      "capabilities": {
        "instructions": {
          "supported": true,
          "mechanism": ".github/copilot-instructions.md, AGENTS.md, CLAUDE.md",
          "aiBadgerSupport": true,
          "scaffoldedFile": ".github/copilot-instructions.md"
        },
        "invariants": {
          "supported": true,
          "mechanism": "copilot-instructions.md sections",
          "aiBadgerSupport": true
        },
        "scopedInstructions": {
          "supported": true,
          "mechanism": ".github/instructions/*.instructions.md with applyTo frontmatter",
          "aiBadgerSupport": true,
          "scaffoldedBy": "scaffolding.json instructionsScoped: true"
        },
        "personas": {
          "supported": true,
          "mechanism": "Custom agents (.github/agents/*.agent.md)",
          "aiBadgerSupport": true,
          "scaffoldedBy": "copilot/adjustments/adjust_agents.py — maps personas to .github/agents/"
        },
        "hooks": {
          "supported": true,
          "mechanism": ".github/hooks/*.json — events: sessionStart, sessionEnd, preToolUse, postToolUse, userPromptSubmitted, agentStop, subagentStop, errorOccurred",
          "configPath": ".github/hooks/",
          "format": {
            "version": 1,
            "hooks": {
              "<event>": [
                {
                  "type": "command",
                  "bash": "...",
                  "powershell": "...",
                  "cwd": ".",
                  "timeoutSec": 10
                }
              ]
            }
          },
          "aiBadgerSupport": true,
          "wiredBy": "copilot/adjustments/adjust_hooks.py"
        },
        "skills": {
          "supported": true,
          "mechanism": ".github/skills/*/SKILL.md or .claude/skills/*/SKILL.md — YAML frontmatter (name, description) + markdown body",
          "aiBadgerSupport": true,
          "scaffoldedBy": "copilot/adjustments/adjust_skills.py — symlinks into .github/skills/"
        },
        "customAgents": {
          "supported": true,
          "mechanism": ".github/agents/*.agent.md — YAML frontmatter (name, description, tools, model, mcp-servers, user-invocable)",
          "aiBadgerSupport": true,
          "scaffoldedBy": "copilot/adjustments/adjust_agents.py — maps personas to .github/agents/"
        },
        "plugins": {
          "supported": true,
          "mechanism": "copilot plugin marketplace/install — delivers skills, hooks, agents, MCP servers",
          "aiBadgerSupport": false
        },
        "mcpServers": {
          "supported": true,
          "mechanism": "CLI: .github/mcp.json (repo-committed) or ~/.copilot/mcp-config.json (user-global), each server carrying a tools allowlist. Coding agent: repository settings UI only",
          "aiBadgerSupport": true,
          "scaffoldedBy": "mcp_tools.generate_copilot_mcp_json() writes .github/mcp.json; copilot/adjustments/adjust_mcp.py proposes the coding agent's snippet"
        },
        "cacheAwareDispatch": {
          "supported": false,
          "mechanism": null,
          "aiBadgerSupport": false
        },
        "feedbackLoop": {
          "supported": "partial",
          "mechanism": "Copilot coding agent can create PRs, but no programmatic feed-badger integration",
          "aiBadgerSupport": false
        }
      }
    },
    "pi": {
      "name": "pi",
      "vendor": "Earendil Works",
      "capabilities": {
        "instructions": {
          "supported": true,
          "mechanism": "AGENTS.md, CLAUDE.md, AGENTS.override.md",
          "aiBadgerSupport": true,
          "scaffoldedFile": "AGENTS.override.md"
        },
        "invariants": {
          "supported": true,
          "mechanism": "AGENTS.override.md sections + AGENTS.md",
          "aiBadgerSupport": true
        },
        "scopedInstructions": {
          "supported": false,
          "mechanism": null,
          "aiBadgerSupport": false
        },
        "personas": {
          "supported": true,
          "mechanism": "subagent extension — native child processes with cwd/model/tools",
          "aiBadgerSupport": true
        },
        "hooks": {
          "supported": true,
          "mechanism": "Extension events: input, tool_call, tool_result, session_start, session_shutdown, agent_settled (34 events total, superset of Claude)",
          "configPath": "~/.pi/agent/extensions/",
          "aiBadgerSupport": true,
          "wiredBy": "pi/adjustments/adjust_hooks.py"
        },
        "skills": {
          "supported": true,
          "mechanism": "SKILL.md YAML frontmatter, Agent Skills standard (79/79 load unmodified from .claude/skills/)",
          "aiBadgerSupport": true,
          "scaffoldedBy": "scaffold.py + pi/adjustments/adjust_skills.py"
        },
        "customAgents": {
          "supported": true,
          "mechanism": "~/.pi/agent/agents/*.agent.md with frontmatter (model, tools, mcp-servers)",
          "aiBadgerSupport": false
        },
        "plugins": {
          "supported": true,
          "mechanism": "pi install npm: or pi install git:",
          "aiBadgerSupport": false
        },
        "mcpServers": {
          "supported": "partial",
          "mechanism": "Via pi-mcp-tools extension (settings.json mcp key), not native",
          "aiBadgerSupport": true,
          "scaffoldedBy": "pi/adjustments/adjust_mcp.py — maps .mcp.json to settings.json format"
        },
        "cacheAwareDispatch": {
          "supported": false,
          "mechanism": null,
          "aiBadgerSupport": false
        },
        "feedbackLoop": {
          "supported": false,
          "mechanism": "No programmatic feed-badger integration",
          "aiBadgerSupport": false
        }
      }
    }
  }
}
